<?xml version="1.0" encoding="utf-8"?>
<!--
  The info band at the top: greeting and clock, then the focused tile's name,
  when it was last opened, and what the remote buttons do.

  Every TextView here has a fixed width and height, including the clocks:
  changing the text of a fixed-size TextView only redraws it, while a
  wrap_content one forces a layout pass of the whole list (on every key press,
  every clock tick, and every return to Home: measured at 32 ms on a Fire TV
  Stick 4K Max). Sizes are scaled in code for "Larger tiles and text".
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="168dp"
    android:paddingStart="48dp" android:paddingEnd="48dp" android:paddingTop="26dp">

    <TextView android:id="@+id/greeting"
        android:layout_width="480dp" android:layout_height="24dp"
        android:layout_alignParentStart="true" android:layout_alignParentTop="true"
        android:layout_marginTop="6dp"
        android:textColor="#B3FFFFFF" android:textSize="16sp"
        android:gravity="center_vertical" android:maxLines="1" />

    <TextClock android:id="@+id/clock"
        android:layout_width="200dp" android:layout_height="36dp"
        android:layout_alignParentEnd="true" android:layout_alignParentTop="true"
        android:format12Hour="h:mm" android:format24Hour="HH:mm"
        android:textColor="#FFFFFFFF" android:textSize="28sp"
        android:fontFamily="sans-serif-light"
        android:gravity="center_vertical|end" android:includeFontPadding="false" />

    <TextClock android:id="@+id/date"
        android:layout_width="320dp" android:layout_height="20dp"
        android:layout_alignParentEnd="true" android:layout_below="@id/clock"
        android:format12Hour="EEEE, MMM d" android:format24Hour="EEEE, MMM d"
        android:textColor="#99FFFFFF" android:textSize="13sp"
        android:gravity="center_vertical|end" />

    <TextView android:id="@+id/heroTitle"
        android:layout_width="match_parent" android:layout_height="54dp"
        android:layout_below="@id/date" android:layout_marginTop="2dp"
        android:textColor="#FFFFFFFF" android:textSize="40sp"
        android:fontFamily="sans-serif-medium" android:letterSpacing="-0.01"
        android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false"
        android:gravity="center_vertical"
        android:shadowColor="#66000000" android:shadowRadius="12" />

    <TextView android:id="@+id/heroMeta"
        android:layout_width="match_parent" android:layout_height="24dp"
        android:layout_below="@id/heroTitle" android:layout_alignParentStart="true"
        android:layout_toStartOf="@id/heroHint" android:layout_marginEnd="24dp"
        android:textColor="#B3FFFFFF" android:textSize="16sp"
        android:maxLines="1" android:ellipsize="end" android:gravity="center_vertical" />

    <TextView android:id="@+id/heroHint"
        android:layout_width="340dp" android:layout_height="24dp"
        android:layout_below="@id/heroTitle" android:layout_alignParentEnd="true"
        android:textColor="#80FFFFFF" android:textSize="14sp"
        android:maxLines="1" android:gravity="center_vertical|end" />
</RelativeLayout>
